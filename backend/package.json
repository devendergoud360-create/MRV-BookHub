{
  "name": "mrv-bookhub-backend",
  "version": "1.0.0",
  "description": "Backend for MRV BookHub - college book management and exchange platform",
  "main": "server.js",
  "scripts": {
    "start": "node --no-warnings=ExperimentalWarning server.js",
    "dev": "node --no-warnings=ExperimentalWarning --watch server.js",
    "init-db": "node --no-warnings=ExperimentalWarning -e \"require('./config/database').initializeDatabase();console.log('DB initialized')\"",
    "seed": "node --no-warnings=ExperimentalWarning database/seed.js",
    "test": "NODE_ENV=test vitest run",
    "test:unit": "NODE_ENV=test vitest run tests/unit",
    "test:integration": "NODE_ENV=test vitest run tests/integration",
    "test:coverage": "NODE_ENV=test vitest run --coverage",
    "lint": "node --check server.js",
    "parity": "node ../scripts/parity_check.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.10.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "supertest": "^7.1.4",
    "vitest": "^3.2.4"
  }
}
