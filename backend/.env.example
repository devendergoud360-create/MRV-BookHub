PORT=5000
HOST=127.0.0.1
LOOPBACK_ONLY=true
NODE_ENV=development
DATABASE_PATH=./database/mrv_bookhub.db
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173
API_BEARER_TOKEN=
LOG_TO_FILE=true
LOG_FILE=./logs/app.log
LOG_LEVEL=info

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="MRV BookHub <noreply@mrvbookhub.local>"

OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

REMINDER_CRON="0 8 * * *"
REMINDER_DAYS_BEFORE=2,1
RESERVATION_EXPIRY_DAYS=3

MAX_UPLOAD_SIZE_MB=5
